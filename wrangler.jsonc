{
  // Thongwai Homestay — static site + booking API (Worker + D1) on Cloudflare Workers
  "name": "thongwai-website",
  "compatibility_date": "2026-08-19",
  "main": "worker.js",
  "vars": { "GH_LOG_REPO": "LucernaPro/Thongwai-booking-log" },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api"]
  },
  "r2_buckets": [
    {
      "binding": "SLIPS",
      "bucket_name": "thongwai-slips"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thongwai-booking",
      "database_id": "8a8663d2-560b-460f-8578-b4bbbbb3a8c1"
    }
  ]
}
